{
  "version": 1,
  "max_chain": 3,
  "step_signals": [
    {
      "signal": "plan, spec, PRD, multi-screen feature with no spec",
      "router": "routr-plan"
    },
    {
      "signal": "find the cause, why is it broken, error, crash",
      "router": "routr-debug"
    },
    {
      "signal": "slow, find out why it's slow, frame drops, bundle, leak",
      "router": "routr-perf"
    },
    {
      "signal": "audit, vulnerabilities, is this secure",
      "router": "routr-security"
    },
    {
      "signal": "review the PR or diff",
      "router": "routr-review"
    },
    {
      "signal": "migration, schema, RLS, query design",
      "router": "routr-database"
    },
    {
      "signal": "build or redesign UI, page, screen, chat UI",
      "router": "routr-frontend"
    },
    {
      "signal": "AI SDK wiring, streaming chat, RAG, tool calling",
      "router": "routr-ai"
    },
    {
      "signal": "write tests, TDD",
      "router": "routr-test"
    },
    {
      "signal": "fix it, patch, commit, open a PR, merge",
      "router": "routr-ship"
    },
    {
      "signal": "deploy, release, get it live, push to prod, submit to store",
      "router": "routr-deploy"
    },
    {
      "signal": "check it in a real browser, smoke test the live site",
      "router": "routr-qa"
    },
    {
      "signal": "animate, smooth it out, polish motion",
      "router": "routr-motion"
    },
    {
      "signal": "make a video, demo or launch clip, video asset",
      "router": "routr-video"
    },
    {
      "signal": "launch copy, SEO, store listing, announce it",
      "router": "routr-marketing"
    }
  ],
  "composition_rules": [
    "Make one step per distinct job the request asks for, in the order the work must happen: plan -> diagnose or build -> fix and commit (routr-ship) -> release (routr-deploy) -> verify live (routr-qa) or promote (routr-video, routr-marketing).",
    "A fix that must go live passes through routr-ship before routr-deploy. Never go straight from routr-debug, routr-perf or routr-security to routr-deploy.",
    "Diagnose before you polish or fix: routr-perf before routr-motion, routr-review before routr-ship, routr-test before routr-qa, routr-plan before building.",
    "Add an unstated step only when the deliverable cannot exist without it: an AI chat feature added to an app with no chat UI yet needs routr-frontend; a page that embeds a video nobody has made yet needs routr-video.",
    "Work the user defers ('deploy later', 'not now', 'we'll handle X separately') is not a step.",
    "A companion is never a step. If a second concern fits a companion signal of the active router, keep a one-router plan and run the companion's checklist inside it.",
    "Each next step must appear in the previous router's handoff list, and a plan has at most max_chain steps."
  ],
  "routers": {
    "routr-agents": {
      "handoff": [
        "routr-debug",
        "routr-frontend"
      ],
      "companions": [],
      "owns_domain_failures": true
    },
    "routr-ai": {
      "handoff": [
        "routr-debug",
        "routr-agents",
        "routr-frontend",
        "routr-deploy",
        "routr-marketing"
      ],
      "companions": [
        "routr-agents"
      ],
      "owns_domain_failures": true
    },
    "routr-database": {
      "handoff": [
        "routr-integrate",
        "routr-debug",
        "routr-ship"
      ],
      "companions": [
        "routr-security"
      ],
      "owns_domain_failures": true
    },
    "routr-debug": {
      "handoff": [
        "routr-ship"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-deploy": {
      "handoff": [
        "routr-debug",
        "routr-qa"
      ],
      "companions": [
        "routr-qa"
      ],
      "owns_domain_failures": false
    },
    "routr-explore": {
      "handoff": [
        "routr-frontend",
        "routr-debug"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-frontend": {
      "handoff": [
        "routr-motion",
        "routr-debug",
        "routr-ship",
        "routr-video"
      ],
      "companions": [
        "routr-perf"
      ],
      "owns_domain_failures": false
    },
    "routr-integrate": {
      "handoff": [
        "routr-frontend",
        "routr-motion"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-marketing": {
      "handoff": [
        "routr-video",
        "routr-frontend",
        "routr-deploy",
        "routr-debug"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-mobile": {
      "handoff": [
        "routr-frontend",
        "routr-marketing",
        "routr-integrate",
        "routr-debug"
      ],
      "companions": [
        "routr-perf"
      ],
      "owns_domain_failures": true
    },
    "routr-motion": {
      "handoff": [
        "routr-frontend",
        "routr-debug"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-perf": {
      "handoff": [
        "routr-ship",
        "routr-debug",
        "routr-database",
        "routr-deploy",
        "routr-motion"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-plan": {
      "handoff": [
        "routr-frontend",
        "routr-ship",
        "routr-ai",
        "routr-agents"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-qa": {
      "handoff": [
        "routr-debug",
        "routr-test"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-refactor": {
      "handoff": [
        "routr-review",
        "routr-debug"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-review": {
      "handoff": [
        "routr-ship",
        "routr-security"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-security": {
      "handoff": [
        "routr-ship",
        "routr-review",
        "routr-database"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-ship": {
      "handoff": [
        "routr-motion",
        "routr-deploy",
        "routr-video"
      ],
      "companions": [
        "routr-security"
      ],
      "owns_domain_failures": false
    },
    "routr-test": {
      "handoff": [
        "routr-ship",
        "routr-review",
        "routr-debug",
        "routr-qa"
      ],
      "companions": [],
      "owns_domain_failures": false
    },
    "routr-video": {
      "handoff": [
        "routr-marketing",
        "routr-frontend",
        "routr-deploy",
        "routr-debug"
      ],
      "companions": [],
      "owns_domain_failures": true
    }
  },
  "companions": [
    {
      "active": "routr-ship",
      "companion": "routr-security",
      "signal": "diff touches auth, sessions, RLS, secrets, payments",
      "section": "skills/routr-security/SKILL.md#companion-checklist"
    },
    {
      "active": "routr-frontend",
      "companion": "routr-perf",
      "signal": "stated perf budget, LCP/INP complaint, heavy media",
      "section": "skills/routr-perf/SKILL.md#companion-checklist"
    },
    {
      "active": "routr-ai",
      "companion": "routr-agents",
      "signal": "output-quality scoring or an eval harness",
      "section": "skills/routr-agents/SKILL.md#companion-checklist"
    },
    {
      "active": "routr-database",
      "companion": "routr-security",
      "signal": "RLS policies, grants, multi-tenant data",
      "section": "skills/routr-security/SKILL.md#companion-checklist"
    },
    {
      "active": "routr-deploy",
      "companion": "routr-qa",
      "signal": "the user asks to verify the deployed preview",
      "section": "skills/routr-qa/SKILL.md#companion-checklist"
    },
    {
      "active": "routr-mobile",
      "companion": "routr-perf",
      "signal": "jank, slow startup, list performance",
      "section": "skills/routr-perf/SKILL.md#companion-checklist"
    }
  ],
  "chains": [
    {
      "id": "new-feature",
      "when": "build a new multi-screen feature end to end with no spec yet",
      "steps": [
        "routr-plan",
        "routr-frontend",
        "routr-ship"
      ],
      "exits": [
        "plan approved",
        "UI built and checked",
        "committed or PR open"
      ]
    },
    {
      "id": "ai-chat-product",
      "when": "a new AI chat product from scratch: plan it, wire the AI SDK, build the chat UI",
      "steps": [
        "routr-plan",
        "routr-ai",
        "routr-frontend"
      ],
      "exits": [
        "plan approved",
        "AI SDK wiring works end to end"
      ]
    },
    {
      "id": "ai-chat-ui",
      "when": "add AI chat or streaming responses to an app that has no chat UI for it yet",
      "steps": [
        "routr-ai",
        "routr-frontend"
      ],
      "exits": [
        "streaming and tools work"
      ]
    },
    {
      "id": "ship-and-brag",
      "when": "ship a change, then make a launch video (and launch copy)",
      "steps": [
        "routr-ship",
        "routr-video",
        "routr-marketing"
      ],
      "exits": [
        "committed or PR open",
        "video rendered"
      ]
    },
    {
      "id": "expo-store-launch",
      "when": "build an Expo app screen, write the store listing, then submit the release",
      "steps": [
        "routr-mobile",
        "routr-marketing",
        "routr-deploy"
      ],
      "exits": [
        "app screens working",
        "listing copy approved"
      ]
    },
    {
      "id": "prod-bugfix",
      "when": "production bug: find the cause, fix and commit, then get it live",
      "steps": [
        "routr-debug",
        "routr-ship",
        "routr-deploy"
      ],
      "exits": [
        "root cause fixed + verified",
        "PR merged / commit pushed"
      ]
    },
    {
      "id": "deploy-verify",
      "when": "deploy, then check the live preview in a real browser",
      "steps": [
        "routr-deploy",
        "routr-qa"
      ],
      "exits": [
        "deployment URL is live"
      ]
    },
    {
      "id": "perf-fix",
      "when": "slow page or endpoint: find out why, fix and commit, then release",
      "steps": [
        "routr-perf",
        "routr-ship",
        "routr-deploy"
      ],
      "exits": [
        "before/after numbers recorded",
        "committed or PR open"
      ]
    },
    {
      "id": "janky-animation",
      "when": "janky or frame-dropping animation: diagnose the cause, then smooth the motion",
      "steps": [
        "routr-perf",
        "routr-motion"
      ],
      "exits": [
        "cause measured and identified"
      ]
    },
    {
      "id": "landing-with-video",
      "when": "build a page that embeds a demo or hero video that has not been made yet",
      "steps": [
        "routr-frontend",
        "routr-video"
      ],
      "exits": [
        "page built; video asset needed"
      ]
    },
    {
      "id": "test-then-qa",
      "when": "write tests, then smoke test the app in the browser",
      "steps": [
        "routr-test",
        "routr-qa"
      ],
      "exits": [
        "tests written and green"
      ]
    },
    {
      "id": "security-fix",
      "when": "security audit, fix and commit the findings, then release",
      "steps": [
        "routr-security",
        "routr-ship",
        "routr-deploy"
      ],
      "exits": [
        "findings triaged with exploit scenarios",
        "fix committed"
      ]
    },
    {
      "id": "db-migration",
      "when": "write a migration, commit it, then release",
      "steps": [
        "routr-database",
        "routr-ship",
        "routr-deploy"
      ],
      "exits": [
        "migration written and tested",
        "committed or PR open"
      ]
    },
    {
      "id": "review-fix",
      "when": "review a PR, then fix and commit the findings",
      "steps": [
        "routr-review",
        "routr-ship"
      ],
      "exits": [
        "findings listed"
      ]
    }
  ]
}
